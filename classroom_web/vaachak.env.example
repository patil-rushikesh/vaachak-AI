# Copy this file to  vaachak.env  and put your own key in it.
# vaachak.env is ignored by git, so your key never gets committed.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_put_your_key_here

# Optional. Only set these if check_ai.py tells you the default model is not available.
# VAACHAK_CHAT_MODEL=llama-3.3-70b-versatile
# VAACHAK_ASR_MODEL=whisper-large-v3-turbo

# Optional email recovery (STARTTLS SMTP; leave empty for operator-issued reset tokens).
VAACHAK_SMTP_HOST=
VAACHAK_SMTP_PORT=587
VAACHAK_SMTP_FROM=
VAACHAK_SMTP_USER=
VAACHAK_SMTP_PASSWORD=
# Global rolling 24-hour generation budget; each teacher also has a 10-job limit.
VAACHAK_GENERATION_DAILY_JOBS=50
