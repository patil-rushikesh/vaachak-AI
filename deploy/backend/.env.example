DOMAIN=api.example.edu
VAACHAK_TEACHER_INVITE=replace-with-a-long-random-invitation
GROQ_API_KEY=
VAACHAK_CHAT_MODEL=
VAACHAK_ASR_MODEL=

# Optional email recovery (STARTTLS SMTP; leave empty for operator-issued reset tokens).
VAACHAK_SMTP_HOST=
VAACHAK_SMTP_PORT=587
VAACHAK_SMTP_FROM=
VAACHAK_SMTP_USER=
VAACHAK_SMTP_PASSWORD=
# Global rolling 24-hour generation budget; each teacher also has a 10-job limit.
VAACHAK_GENERATION_DAILY_JOBS=50

# Only needed for a separately hosted web app; exact HTTPS origins, comma-separated.
VAACHAK_CORS_ORIGINS=
