# Export these in your shell; the application does not auto-load this file.
# Omit DATABASE_URL to use local SQLite during a quick prototype.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/vaachak
VAACHAK_DATA_DIR=./data
# Optional speech analysis uses an explicitly installed LOCAL model directory.
# VAACHAK_WHISPER_MODEL=/absolute/path/to/faster-whisper-small.en

# Optional meaning suggestions. Providers: ollama, xai, groq.
# Ollama stays on this machine and requires no API key.
# VAACHAK_TEXT_PROVIDER=ollama
# VAACHAK_TEXT_MODEL=qwen2.5:0.5b-instruct
# For external inference, select the intended provider/model and set only its key.
# XAI_API_KEY=
# GROQ_API_KEY=
# Keep AI meaning grades teacher-reviewed until the configured model is evaluated.
# VAACHAK_AUTO_GRADE_MEANING=0
